# Optional systemd environment file for agent_voice.
# Copy to /etc/default/agent-voice and replace the placeholder value.

OPENAI_API_KEY=replace-me
XAI_API_KEY=
RUST_LOG=info,agent_voice=debug
LLM_PROVIDER=openai
VOICE_PROVIDER=disabled
SPEECH_STT_PROVIDER=openai
SPEECH_TTS_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VOICE_TRANSPORT=chat_completions
OPENAI_VOICE_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_VOICE_MODEL=gpt-audio-1.5
OPENAI_VOICE_NAME=alloy
OPENAI_VOICE_INSTRUCTIONS=You are a helpful voice agent on a phone call. Keep replies brief, natural, and conversational.
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE_NAME=eve
XAI_VOICE_INSTRUCTIONS=You are a helpful voice agent on a phone call. Keep replies brief, natural, and conversational.
XAI_REASONING_EFFORT=none
XAI_TRANSCRIPTION_MODEL=grok-transcribe
XAI_LANGUAGE_HINT=
SHERPA_ONNX_PYTHON_BIN=/opt/agent_voice/.venv/bin/python
SHERPA_ONNX_BRIDGE_SCRIPT=/opt/agent_voice/python/sherpa_onnx_bridge.py
